# --- Mode
# demo = hackathon seed data, optional simulated voice, DEMO_CALL_RECIPIENT
# clinic = real patients, MongoDB required, calls go to patient.phone_e164
JIVANA_MODE=demo
CLINIC_NAME=My Clinic
CLINIC_LEAD_NAME=
# Optional Bearer token for all /api/* except meta, health, webhooks
CLINIC_API_KEY=

# --- Bolna (live voice)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
# Demo mode only: all live calls ring this number
DEMO_CALL_RECIPIENT=
PUBLIC_BASE_URL=
BOLNA_WEBHOOK_SECRET=

# --- Storage (required for JIVANA_MODE=clinic)
MONGO_URL=

CORS_ORIGINS=http://localhost:5173
SIMULATED_CALL_SECONDS=8
AUTO_DIAL_ENABLED=
AUTO_DIAL_INTERVAL_SECONDS=120
STUCK_CALL_MINUTES=25
