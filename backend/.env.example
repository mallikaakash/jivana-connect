# Copy to backend/.env. Everything is optional: with nothing set the API runs in
# simulated voice mode on an in-memory store seeded from ../shared/seed.json.

# --- Bolna (live voice). All three of KEY, AGENT_ID and DEMO_CALL_RECIPIENT are required for live mode.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional caller ID (E.164). Omit to use Bolna's default number.
BOLNA_FROM_NUMBER=
# E.164 phone of the team member who answers as the synthetic patient. ALL live calls go here.
DEMO_CALL_RECIPIENT=
# Public URL of this API (ngrok / cloudflared) — used for the webhook URL you set on the Bolna agent.
PUBLIC_BASE_URL=
# Optional shared secret; Bolna has no signature, so it is checked as ?token=... on the webhook URL.
BOLNA_WEBHOOK_SECRET=

# --- Storage. Unset = in-memory. Example: mongodb://localhost:27017
MONGO_URL=

# --- Misc
CORS_ORIGINS=http://localhost:5173
SIMULATED_CALL_SECONDS=8
