# Copy to backend/.env.gcp (gitignored). Used by scripts/deploy-gcp-clinic.sh only.

JIVANA_MODE=clinic
CLINIC_NAME=Jivana Connect
CLINIC_LEAD_NAME=Dr. Sharma
# Staff / reviewer API gate (Bearer token in dashboard sign-in)
# For hackathon: set a demo key and CLINIC_PUBLISH_REVIEWER_KEY=true so judges see it on the sign-in page
CLINIC_API_KEY=
CLINIC_PUBLISH_REVIEWER_KEY=false
# Load shared/seed.json into Mongo when empty + allow "Load demo data" in UI (hackathon)
CLINIC_DEMO_SEED_ENABLED=false
# Empty all Mongo data for QA (POST /api/clinic/reset-workspace with staff auth)
CLINIC_ALLOW_WORKSPACE_RESET=false
# Optional: ring one Bolna-verified number for every outbound call (hackathon)
# CLINIC_DIAL_OVERRIDE_E164=+919876543210
# Optional: accept Firebase Google sign-in (same GCP project as Hosting)
# FIREBASE_PROJECT_ID=project-bf77a013-c0b3-413c-a75

# Hosted Mongo — required (Cloud Run cannot use 127.0.0.1)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/jivana?retryWrites=true&w=majority

BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
BOLNA_WEBHOOK_SECRET=

# Set after you know the frontend URL (comma-separated if multiple)
CORS_ORIGINS=https://project-bf77a013-c0b3-413c-a75.web.app,https://project-bf77a013-c0b3-413c-a75.firebaseapp.com

# First deploy: leave empty — deploy script sets this to the Cloud Run URL
PUBLIC_BASE_URL=

# Daily Bolna batch for tomorrow's appointment confirmations (recommended). Disables default auto-dial.
CLINIC_DAILY_CONFIRMATION_BATCH=true
CLINIC_CONFIRMATION_BATCH_TIME=10:00
# Optional: POST /api/clinic/cron/daily-confirmation-batch with header X-Clinic-Cron-Secret
CLINIC_CRON_SECRET=
AUTO_DIAL_ENABLED=false
AUTO_DIAL_INTERVAL_SECONDS=120
# Phase 2: retries on single outbound /call (not batch-level)
BOLNA_CALL_RETRY_ENABLED=true
STUCK_CALL_MINUTES=25
